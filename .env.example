# The Dan cloud's one address, without /graphql (DAN-45). One copy of this site
# serves every shop: each call names the shop by the address the site is
# visited at (goldendragon.dan.partners, or the shop's own domain).
NEXT_PUBLIC_DAN_API_URL=https://cloud.dan.partners
# Local work only: the shop's address name, since localhost names no shop.
# NEXT_PUBLIC_DAN_SHOP=goldendragon
